{
  "collections": [
    {
      "name": "products",
      "source": "shared/products",
      "destination": "products",
      "enabled": true,
      "data_model": {
        "images": { "match": "*.{jpg,jpeg,png,gif,webp}", "type": "paths",  "copy": true,  "required": false },
        "data":   { "match": "product.json",               "type": "object", "copy": false, "required": true,
          "schema": {
            "name":        { "type": "string", "label": "Name", "required": true },
            "price":       { "type": "string", "label": "Price" },
            "description": { "type": "string", "label": "Short description" },
            "details":     { "type": "text",   "label": "Details" }
          }
        }
      }
    }
  ]
}
